{
  "project": "Riwi Internal Messaging Platform",
  "version": "1.0.0",
  "normalization_documentation": {
    "1FN_first_normal_form": {
      "status": "COMPLIES",
      "justification": "All attributes are atomic. Message contents, user profiles, and channel metadata are stored in non-composite, single-valued columns. Repeating groups such as channel members or message lists have been moved into dedicated child tables (rw_channel_members and rw_messages)."
    },
    "2FN_second_normal_form": {
      "status": "COMPLIES",
      "justification": "All non-key attributes fully depend on the complete primary key of their respective tables. In rw_channel_members, attributes like rw_member_role and rw_last_read_at depend on the entire primary key and composite foreign keys (rw_channel_id, rw_user_id), with no partial dependencies."
    },
    "3FN_third_normal_form": {
      "status": "COMPLIES",
      "justification": "All transitive dependencies have been eliminated. User job titles, roles, and emails depend solely on the user entity (rw_users). Messages reference user and channel IDs via foreign keys without duplicating user profile details or channel metadata within the message records."
    },
    "implicit_business_rules": [
      "Row Level Security (RLS) is strictly enforced in PostgreSQL using app.current_user_id.",
      "Physical deletion of messages is strictly forbidden; soft deletion via rw_is_deleted and rw_deleted_at must be used.",
      "User authentication relies on BCrypt password hashes ($2a$10$...). Plaintext passwords are NEVER stored.",
      "All timestamps are stored as timestamptz in UTC.",
      "AI Copilot RAG queries can ONLY retrieve context from channels where the authenticated actor is an active member."
    ]
  },
